<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="r24z3.MainPage"
             Padding="20">

    <Grid RowDefinitions="Auto, *, Auto">
        <Label Text="Przegladarka plikow" FontSize="20" FontAttributes="Bold" Margin="0,0,0,10" />

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding ListaPlikow}"
                        SelectionMode="Single"
                        SelectionChanged="OnFileSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="{Binding Nazwa}" FontAttributes="Bold"/>
                            <Label Text="{Binding Rozmiar}" FontSize="Caption" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="1" Text="Usun" 
                                Clicked="OnDeleteClicked" 
                                BackgroundColor="Red" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="AllFiles" Grid.Row="2" Margin="0,10,0,0"/>
    </Grid>
</ContentPage>