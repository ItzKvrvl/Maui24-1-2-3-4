<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="r24z2.MainPage">

    <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
            
        <Editor x:Name="YourText" HeightRequest="100"/>
        <Button x:Name="AddTextBtn" Text="Dodaj wpis" Clicked="AddTextBtnClicked"/>
        <ScrollView>
            <Label x:Name="YourMessages"/>
        </ScrollView>
        <Button Clicked="ClearBtn" Text="wyczysc"/>
    </VerticalStackLayout>

</ContentPage>
