<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="r24z4.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <Label 
                Text="Eksport import plików"
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                FontSize="32"/>
            <Editor x:Name="EditorWpis"
                Placeholder="Wpisz coś tutaj!"/>
            
            <HorizontalStackLayout HorizontalOptions="Center">
                <Button x:Name="Eksportuj"
                    Text="Ekspotruj"
                    Clicked="OnEksportClicked"/>
                <Button x:Name="Importuj"
                    Text="Importuj"
                    Clicked="OnImportClicked"/>
            </HorizontalStackLayout>
            
            <Label x:Name="Informacja"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
